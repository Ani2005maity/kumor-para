<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Credit Note - {{invoiceNumber}}</title>
  <style>
    @page { size: A4 portrait; margin: 15mm; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #1f2937;
      padding: 24px;
      font-size: 13px;
    }
    .invoice-container { max-width: 800px; margin: 0 auto; }
    .header {
      display: flex;
      justify-content: space-between;
      border-bottom: 2px solid #e5e7eb;
      padding-bottom: 16px;
      margin-bottom: 20px;
    }
    .brand h1 { margin: 0; color: #92400e; font-size: 24px; font-weight: 800; }
    .doc-badge {
      display: inline-block;
      padding: 4px 10px;
      background: #fee2e2;
      color: #b91c1c;
      font-weight: 700;
      font-size: 14px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .card { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; }
    .card-title { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6b7280; margin-bottom: 6px; }
    table.line-items { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    table.line-items th { background: #f3f4f6; padding: 8px 10px; font-size: 11px; text-align: left; }
    table.line-items td { padding: 8px 10px; border-bottom: 1px solid #f3f4f6; }
    .text-right { text-align: right; }
    .totals-area { display: flex; justify-content: space-between; margin-bottom: 24px; }
    .amount-words { width: 55%; background: #fdf8f6; padding: 10px; border-radius: 6px; }
    .totals-table { width: 40%; }
    .totals-row { display: flex; justify-content: space-between; padding: 4px 0; }
    .totals-row.grand-total { font-weight: 800; font-size: 15px; border-top: 2px solid #e5e7eb; padding-top: 6px; color: #b91c1c; }
    .footer { text-align: center; color: #6b7280; font-size: 11px; border-top: 1px solid #e5e7eb; padding-top: 12px; }
  </style>
</head>
<body>
  <div class="invoice-container">
    <div class="header">
      <div class="brand">
        <h1>Kumor Para</h1>
        <p>Marketplace for Handmade Goods by Independent Indian Creators</p>
      </div>
      <div style="text-align: right;">
        <div class="doc-badge">CREDIT NOTE</div>
        <div style="margin-top: 6px;"><strong>Credit Note No:</strong> {{invoiceNumber}}</div>
        <div><strong>Original Invoice Ref:</strong> {{originalInvoiceNumber}}</div>
        <div><strong>Date:</strong> {{formattedDate}}</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-title">Issued By (Supplier)</div>
        <p><strong>{{supplierSnapshot.name}}</strong></p>
        <p>{{supplierAddressString}}</p>
        {{#if hasGstin}}<p><strong>GSTIN:</strong> {{supplierSnapshot.gstin}}</p>{{/if}}
      </div>
      <div class="card">
        <div class="card-title">Recipient</div>
        <p><strong>{{buyerSnapshot.name}}</strong></p>
        <p>{{buyerShippingString}}</p>
      </div>
    </div>

    <table class="line-items">
      <thead>
        <tr>
          <th>#</th>
          <th>Description</th>
          <th class="text-right">Qty Reversal</th>
          <th class="text-right">Credit Value</th>
          <th class="text-right">Tax Reversal</th>
          <th class="text-right">Total Credit</th>
        </tr>
      </thead>
      <tbody>
        {{#each lineItems}}
        <tr>
          <td>{{index}}</td>
          <td>{{title}} (Cancellation Reversal)</td>
          <td class="text-right">-{{qty}}</td>
          <td class="text-right">-{{taxableValueFormatted}}</td>
          <td class="text-right">-{{taxFormatted}}</td>
          <td class="text-right" style="color: #b91c1c;"><strong>-{{lineTotalFormatted}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="totals-area">
      <div class="amount-words">
        <div>Total Credit in Words:</div>
        <strong style="color: #b91c1c;">{{amountInWords}}</strong>
      </div>
      <div class="totals-table">
        <div class="totals-row grand-total">
          <span>Net Credit Amount:</span>
          <span>-{{grandTotalFormatted}}</span>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>Credit note issued by Kumor Para on behalf of the supplier to reverse original invoice {{originalInvoiceNumber}}.</p>
    </div>
  </div>
</body>
</html>
