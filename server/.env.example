# ==============================================================================
# Kumor Para Marketplace — Server Environment Variables (Production & Staging)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Replica Set / MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kumorpara?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate 64-char cryptographically random strings)
JWT_SECRET=replace_with_a_very_long_secure_random_string_for_production_jwt
JWT_REFRESH_SECRET=replace_with_a_very_long_secure_random_string_for_refresh_jwt
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security & Cross-Domain Settings
# Set COOKIE_DOMAIN if frontends and backend share a common root domain (e.g. .kumorpara.com)
# Set COOKIE_SAME_SITE to 'none' if frontends are on completely different domains (requires HTTPS/secure=true)
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (Frontend Applications)
# Supports single URLs or comma-separated lists of domains
CORS_ORIGIN_CUSTOMER=https://kumorpara.com
CORS_ORIGIN_SELLER=https://artisan.kumorpara.com
CORS_ORIGIN_ADMIN=https://admin.kumorpara.com
CLIENT_URL=https://kumorpara.com

# GST Tax Invoicing Trigger
INVOICE_TRIGGER=payment_confirmed

# ==============================================================================
# OTP & Security Configuration
# ==============================================================================
OTP_PEPPER=replace_with_a_secure_random_otp_pepper_string_for_hmac_hashing

# OTP Provider: 'real' for production SMTP delivery; 'mock' for local automated tests
OTP_PROVIDER=real

# Email OTP Delivery (Nodemailer SMTP)
# Supports Gmail (App Password), Brevo, SendGrid, Amazon SES, Postmark, Mailgun, etc.
EMAIL_FROM=Kumor Para Security <security@kumorpara.com>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
SMTP_SECURE=false

# ==============================================================================
# Payment Gateway (Razorpay India)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# Cloud Media Storage (Cloudinary)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
